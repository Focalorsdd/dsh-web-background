{
  "name": "dsh-web-background",
  "version": "0.1.0",
  "description": "DeepSeek Harness Web GUI custom background: injects a background image/via client CSS so text stays readable.",
  "type": "module",
  "main": "lib/index.js",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "assets"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1"
  },
  "license": "MIT"
}
